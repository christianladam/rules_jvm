"""The `naming` module extension, which picks the separator for generated target names."""

DEFAULT_SEPARATOR = "-"

SEPARATORS = ["-", "_"]

_REPO_NAME = "contrib_rules_jvm_naming"

def _naming_repo_impl(rctx):
    rctx.file("BUILD.bazel", """load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "naming",
    srcs = ["naming.bzl"],
    visibility = ["//visibility:public"],
)
""")
    rctx.file("naming.bzl", '"""Generated by contrib_rules_jvm\'s `naming` extension."""\n\nSEPARATOR = "{}"\n'.format(rctx.attr.separator))

_naming_repo = repository_rule(
    implementation = _naming_repo_impl,
    attrs = {
        "separator": attr.string(values = SEPARATORS, mandatory = True),
    },
)

_configure = tag_class(
    doc = "Sets how contrib_rules_jvm's macros name the targets they generate.",
    attrs = {
        "separator": attr.string(
            doc = """The separator placed between a target's name and the words the macro adds,
            and between those words: `"-"` gives `foo-test-lib`, `"_"` gives `foo_test_lib`.""",
            values = SEPARATORS,
            mandatory = True,
        ),
    },
)

def _naming_impl(mctx):
    separator = DEFAULT_SEPARATOR
    for mod in mctx.modules:
        # Generated names are visible to every module in the build, so only the root
        # module gets to choose them.
        if not mod.is_root:
            continue
        if len(mod.tags.configure) > 1:
            fail("naming.configure may be called at most once")
        for tag in mod.tags.configure:
            separator = tag.separator
    _naming_repo(name = _REPO_NAME, separator = separator)
    return mctx.extension_metadata(reproducible = True)

naming = module_extension(
    implementation = _naming_impl,
    doc = """Chooses the separator contrib_rules_jvm uses in the names of targets its macros
    generate: `java_test_suite`'s `-test-lib`, `-test-deps-lib` and `-test-runtime-deps-lib`
    libraries, and the `-checkstyle`, `-pmd` and `-spotbugs` lint tests.

    Only the root module's setting is used. The default is `"-"`.

    ```starlark
    naming = use_extension("@contrib_rules_jvm//java:extensions.bzl", "naming")
    naming.configure(separator = "_")
    ```
    """,
    tag_classes = {"configure": _configure},
)
